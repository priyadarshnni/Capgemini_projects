using System.ComponentModel.DataAnnotations;

namespace AirplaneAPI.Validations
{
    public class AllowedEngineTypeAttribute : ValidationAttribute
    {
        private static readonly string[] _allowed = new[] { "Jet", "Turboprop", "Piston" };

        protected override ValidationResult? IsValid(object? value, ValidationContext validationContext)
        {
            if (value is null)
            {
                return ValidationResult.Success;
            }

            if (value is string s && _allowed.Contains(s))
            {
                return ValidationResult.Success;
            }

            return new ValidationResult($"Engine type must be one of: {string.Join(", ", _allowed)}");
        }
    }
}