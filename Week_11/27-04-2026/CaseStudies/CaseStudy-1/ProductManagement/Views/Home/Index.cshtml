@{
    ViewData["Title"] = "Home Page";
}

<div class="row align-items-center py-5">
    <div class="col-lg-6 text-center text-lg-start">
        <h1 class="display-4 fw-semibold text-dark mb-3">Product Menu</h1>
        <p class="lead text-secondary mb-4" style="font-weight: 300;">A clean, simple, and straightforward approach to managing your catalog, product pricing, and categories.</p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-4 mb-lg-3">
            <a asp-controller="Products" asp-action="GetAll" class="btn btn-outline-dark btn-lg px-4 me-md-2" style="font-size: 1rem;"><i class="bi bi-collection me-2"></i>Catalog</a>
            <a asp-controller="Products" asp-action="Create" class="btn btn-light btn-lg px-4 border" style="font-size: 1rem;"><i class="bi bi-plus-circle me-2 text-muted"></i>Add</a>
        </div>
    </div>
    <div class="col-lg-6 my-5 d-none d-lg-block">
        <div class="p-5 text-center bg-white border rounded">
            <i class="bi bi-box-seam text-secondary mb-3 mx-auto mt-2" style="font-size: 5rem; opacity: 0.5;"></i>
            <h4 class="text-dark fw-light mt-3">Organize Effortlessly</h4>
            <p class="mb-0 text-muted small">Keep your products tidy and accessible.</p>
        </div>
    </div>
</div>
