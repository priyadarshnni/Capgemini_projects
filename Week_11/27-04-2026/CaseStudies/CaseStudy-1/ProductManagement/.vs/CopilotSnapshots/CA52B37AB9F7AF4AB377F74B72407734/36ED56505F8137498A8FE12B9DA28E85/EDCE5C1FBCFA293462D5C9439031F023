@model ProductManagement.DTOs.ProductResponseDto

@{
    ViewData["Title"] = "Product Details";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-8">
        <div class="card shadow border-0 overflow-hidden rounded-4">
            <div class="card-header bg-info text-white p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0"><i class="bi bi-info-circle me-2"></i>Product Details</h3>
                    <span class="badge bg-white text-info fs-6 px-3 py-2 rounded-pill">ID #@Model.Id</span>
                </div>
            </div>
            
            <div class="card-body p-5 bg-white">
                <div class="row mb-5 text-center px-4">
                    <div class="col-sm-6 border-end">
                        <i class="bi bi-tag text-muted fs-4 d-block mb-1"></i>
                        <small class="text-uppercase text-muted fw-bold tracking-wide">Product Name</small>
                        <h4 class="mt-2 fw-semibold text-dark">@Model.Name</h4>
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-currency-dollar text-success fs-4 d-block mb-1"></i>
                        <small class="text-uppercase text-muted fw-bold tracking-wide">Price</small>
                        <h4 class="mt-2 fw-bold text-success">@Model.Price.ToString("C")</h4>
                    </div>
                </div>

                <hr class="text-muted border-2 opacity-10 mb-4" />

                <div class="row px-md-4">
                    <div class="col-sm-4 mb-3">
                        <div class="p-3 bg-light rounded-3 text-center h-100">
                            <i class="bi bi-folder2-open text-primary fs-3 mb-2 d-block"></i>
                            <span class="d-block text-muted small fw-bold mb-1">Category</span>
                            <span class="badge bg-primary fs-6 px-3">@Model.CategoryName</span>
                        </div>
                    </div>
                    
                    <div class="col-sm-8 mb-3">
                        <div class="p-4 bg-light rounded-3 h-100">
                            <h6 class="text-muted fw-bold text-uppercase mb-2"><i class="bi bi-card-text me-2"></i>Description</h6>
                            <p class="mb-0 text-dark">@(string.IsNullOrEmpty(Model.Description) ? "No detailed description available for this product." : Model.Description)</p>
                        </div>
                    </div>
                </div>

            </div>
            <div class="card-footer bg-light p-4 border-top text-end">
                <a asp-action="GetAll" class="btn btn-outline-secondary px-4 me-2">
                    <i class="bi bi-arrow-left me-1"></i>Back to Catalog
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-5 shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit Product
                </a>
            </div>
        </div>
    </div>
</div>
