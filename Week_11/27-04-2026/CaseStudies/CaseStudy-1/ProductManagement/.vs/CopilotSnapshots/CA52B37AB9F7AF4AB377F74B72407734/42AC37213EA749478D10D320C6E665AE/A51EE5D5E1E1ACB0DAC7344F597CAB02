@model ProductManagement.DTOs.ProductRequestDto

@{
    ViewData["Title"] = "Create Product";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-primary text-white p-4 rounded-top-4">
                <h3 class="mb-0"><i class="bi bi-box-fill me-2"></i>Create New Product</h3>
            </div>
            <div class="card-body p-4 p-md-5 bg-white">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Name" class="form-control" placeholder="Product Name" />
                        <label asp-for="Name"><i class="bi bi-tag me-1"></i>Name</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Price" class="form-control" placeholder="0.00" type="number" step="0.01" />
                        <label asp-for="Price"><i class="bi bi-currency-dollar me-1"></i>Price</label>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="CategoryId" class="form-control" placeholder="Category Code" />
                        <label asp-for="CategoryId"><i class="bi bi-folder2-open me-1"></i>Category ID</label>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control" placeholder="Detailed description" style="height: 120px"></textarea>
                        <label asp-for="Description"><i class="bi bi-card-text me-1"></i>Description</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-5 pt-3 border-top">
                        <a asp-action="GetAll" class="btn btn-light px-4 me-md-2" tabindex="-1">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Create
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
